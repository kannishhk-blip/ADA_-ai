# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

# Resume matching runs locally with sentence-transformers; no OpenAI API key is needed.

# Twilio credentials — optional, used for WhatsApp and call notifications.
# Get these at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=+1234567890
MY_PHONE_NUMBER=+91XXXXXXXXXX
